meta {
  name: Get my rating for product
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/ratings/me/{{barcode}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Returns the authenticated caller's rating for the given product, or 404 if they haven't rated it yet.

  No longer called by the app: since P8-002 the product screen reads "my rating" out of the cached
  `/api/users/me/ratings` payload instead, which removes a round trip per product open and works offline.
  This endpoint remains for API consumers and ad-hoc testing.

  Errors:
  - 404 — product not found in the local cache, OR product exists but the caller has not rated it.
}
