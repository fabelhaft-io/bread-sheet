meta {
  name: Get ratings for product
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/ratings/product/{{productId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Returns all ratings for a product (most recent first), each with the author's id / username / avatar.
  `:productId` must be a UUID (400 { code: 'invalid_product_id' } otherwise, TICKET-P6-009).
}
