meta {
  name: Get pending edit for product
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/products/{{productId}}/edits/pending
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  TICKET-P5-006 (re-keyed in TICKET-P6-009) — Current pending edit for a product, or { edit: null }.
  `:productId` must be a UUID (400 { code: 'invalid_product_id' } otherwise); a REJECTED or unknown
  product id is 404 ({ error: 'product_not_found' }), via services/productVisibility.ts.

  Drives the client's review banner and the diff screen. Response shape:

  {
    "edit": {
      "editId": "...",
      "productId": "...",
      "originalValues": { ...snapshot at proposal time, image keys resolved to URLs },
      "proposedChanges": { ...changed fields only },
      "approvals": 1,
      "rejections": 0,
      "createdAt": "...",
      "viewer": { "isAuthor": false, "vote": null, "dismissed": false }
    }
  }

  `viewer` is computed for the calling user: authors and users who voted/dismissed
  don't get the banner. Vote counts are exposed; voter identities are not.
}
